{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the main window may call Macroscope's commands and subscribe to host events; no filesystem, shell, or opener plugin commands are exposed.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-model-access",
    "allow-enter-api-key-native",
    "allow-save-api-key",
    "allow-remove-api-key",
    "allow-test-api-key",
    "allow-refresh-muse-status",
    "allow-open-muse-sign-in",
    "allow-select-route",
    "allow-set-muse-unverified-ok",
    "allow-set-local-only",
    "allow-pick-csv",
    "allow-load-sample-csv",
    "allow-draft-task",
    "allow-answer-question",
    "allow-update-mapping",
    "allow-outbound-preview",
    "allow-start-build",
    "allow-build-state",
    "allow-stop-build",
    "allow-save-tool",
    "allow-list-tools",
    "allow-get-tool",
    "allow-install-sample-tool",
    "allow-delete-tool",
    "allow-pick-output-dir",
    "allow-stage-run",
    "allow-commit-run",
    "allow-discard-run",
    "allow-reveal-output",
    "allow-list-activity",
    "allow-list-receipts",
    "allow-privacy-overview",
    "allow-delete-outbound-history",
    "allow-emergency-stop",
    "allow-open-external",
    "allow-show-state",
    "allow-start-show",
    "allow-pause-show",
    "allow-stop-show",
    "allow-list-connectors",
    "allow-set-connector-url",
    "allow-set-client-credentials",
    "allow-begin-connect",
    "allow-complete-connect",
    "allow-test-connection",
    "allow-disconnect",
    "allow-preview-connector-tools",
    "allow-connection-suggestions",
    "allow-dismiss-suggestion",
    "allow-build-try-input",
    "allow-export-tool",
    "allow-revoke-tool",
    "allow-restore-tool",
    "allow-delete-preview",
    "allow-delete-data",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
