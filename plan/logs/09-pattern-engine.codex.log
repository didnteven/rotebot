/** Todo status (tdd SS4.6.3): closed in the runtime, wire-open. */
export type TodoStatus = "pending" | "inProgress" | "completed" | "cancelled" | (string & {});

/** Raw token counters, verbatim from the durable record (tdd SS4.6.5, the runtime's `Usage`, camelCased). Not directly summable across providers — sum the counted-once derivations instead (#8803). */
export interface TokenUsage {
  /** Cache read tokens, only when the provider distinguishes writes/reads. */
  cacheReadTokens?: number;
  /** Cache write tokens, only when the provider distinguishes writes/reads. */
  cacheWriteTokens?: number;
  /** Provider-reported cache tokens (inside or beside `inputTokens`, provider-convention-dependent — the reason `promptTokens` exists). */
  cachedTokens: number;
  /** Provider-reported input tokens. */
  inputTokens: number;
  /** Provider-reported output tokens. */
  outputTokens: number;
  /** Output tokens spent on reasoning, when the provider reports it. */
  reasoningTokens: number;
}

/** `toolCall.displayLabel`: the call's words in three forms, each one line of plain text, always present together. The item's `status` picks the form. */
export interface ToolDisplayLabel {
  /** Shown while the call runs (`inProgress`), e.g. "Setting up Computer Use". */
  active: string;
  /** Shown after the call succeeds (`completed`), e.g. "Set up Computer Use". */
  done: string;
  /** Shown for every other status (failed, rejected, timed out, cancelled), beside that status; never implies success. */
  neutral: string;
}
