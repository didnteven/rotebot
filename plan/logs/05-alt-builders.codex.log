  permissionProfile?: string;
  /** Cold-resume replacement choice; omission preserves the retained choice. A warm attach rejects a different or unestablished choice as invalidParams. Explicit null is invalid. */
  recoveryMode?: RecoveryMode;
  /** The session to load. */
  sessionId: string;
}

/** `session/resume` result (tdd SS2.5.2). */
export interface SessionResumeResult {
  /** The served history. */
  history: SessionHistory;
  /** How the last folded turn ended (tdd SS2.5.2, ADR 36635 D2). **Additive-optional**; absence is a non-assertion. */
