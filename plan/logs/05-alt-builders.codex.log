export interface ApprovalAmendment {
  durability: ApprovalAmendmentDurability;
  rulePreview: string;
}

export type ApprovalAmendmentDurability = "session" | "localPersistent" | (string & {});

export interface ApprovalChange {
  choiceId?: string;
  decision?: ApprovalDecision;
  executable?: boolean;
  kind: string;
  reason?: string;
  reparsed?: boolean;
  requirementId?: ApprovalRequirementRef;
  status?: ApprovalPersistenceStatus;
}

export interface ApprovalChoice {
  acceptsFeedback?: boolean;
  choiceId: string;
  decision: ApprovalDecision;
  label: string;
  rulePreview?: string;
  scope: ApprovalChoiceScope;
}

export type ApprovalChoiceScope = "once" | "session" | "localPersistent" | (string & {});

/** `approval/decide` params (tdd SS5.4): the decision. A standard SS3 command — requires the session loaded on this host, requires `commandId`, durable intake before ack, value-identical replay. */
export interface ApprovalDecideParams {
  /** The approval being decided. */
  approvalId: string;
  /** One of the current `availableChoices`; else -32052. */
  choiceId: string;
  /** The SS3.1.1 idempotency handle (UUIDv7). */
  commandId: string;
  /** Free-text guidance delivered to the model with the denial. Only valid on choices with `acceptsFeedback`. Never persisted in the durable audit record (live steer only), so it is absent from `approval/resolved` (tdd SS5.4). Omitted and explicit `null` both mean "no feedback" (#23468). */
  feedback?: string | null;
  /** Must equal the approval's `currentRequirementId`. The multi-stage race guard: a decision aimed at stage 1 can never accidentally satisfy stage 2, and a stale value is -32053 (tdd SS5.4). */
  requirementId: ApprovalRequirementRef;
  /** The target session. */
  sessionId: string;
}

/** `approval/decide` result (tdd SS5.4). Admission-ack rules still apply: the authoritative outcome is `approval/resolved` / `approval/updated` on the view stream. */
export interface ApprovalDecideResult {
  /** The approval this decision was applied to. */
  approvalId: string;
  /** Echoes the client's id. */
  commandId: string;
  /** Admission status. */
  status: CommandStatus;
  /** `false` when the choice satisfied a stage but further requirements remain (the approval stays pending and an updated `approval/request` follows); `true` when this decision produced the terminal `DecisionApplied` (tdd SS5.4). */
  terminal: boolean;
}

export type ApprovalDecision = "approved" | "approvedForSession" | "approvedPolicyAmendment" | "denied" | "deniedPolicyAmendment" | "timedOut" | "abort" | (string & {});

/** `approval/listPending` params (tdd SS5.7): the pull dual of the re-issued requests. A log-fold read — no lease, works on loaded and unloaded sessions, never subscribes. */
export interface ApprovalListPendingParams {
  /** The session to read. */
  sessionId: string;
}

/** `approval/listPending` result (tdd SS5.7). Ordering is by opening `viewCursor`; empty arrays when nothing is pending. The result is point-in-time — to act on it race-safely, `approval/decide` carries the `requirementId` guard regardless of how the client learned the state. */
export interface ApprovalListPendingResult {
  /** Exactly the `approval/request` params of tdd SS5.3, one per pending approval. */
  approvals: ApprovalRequestParams[];
  /** Exactly the `userInput/request` params of tdd SS5.10, one per pending prompt. */
  userInputs: UserInputRequestParams[];
}

/** The approval enforcement modes (tdd SS5.12, camelCased `ApprovalBackendMode`). **Closed** by design (D-006, select-never-create): a client selects a preconfigured mode and can never construct one; widening this enum is a deliberate, gate-visible protocol change. */
export type ApprovalMode = "allowAll" | "promptUnmatched" | "onRequest" | "denyUnmatched";

/** Whether a mode change did anything (tdd SS5.12), mirroring `ApprovalReconfigureApplyOutcome`. Apply failures are `commandRejected`. */
export type ApprovalModeApplyOutcome = "completed" | "noop" | (string & {});

/** How an approval mode took effect (tdd SS5.12, the effective-mode projection's `source` vocabulary). Open. */
export type ApprovalModeSource = "startup" | "replay" | "approvalReconfigure" | (string & {});

export interface ApprovalOrigin {
  command?: string;
  kind: string;
  url?: string;
}

export type ApprovalPersistenceStatus = "succeeded" | "failed" | (string & {});

export type ApprovalPolicyResult = "allow" | "deny" | (string & {});

/** Full params shared by `approval/request` and `approval/requested`. */
export interface ApprovalRequestParams {
  approvalId: string;
  availableChoices: ApprovalChoice[];
  currentRequirementId: ApprovalRequirementRef;
  itemId: string;
  judgeEscalated: boolean;
  protectedWrite: boolean;
  rawArgs: string;
  sessionId: string;
  sourceRange: SourceRange;
  /** Present only for a child (native subagent) approval projected onto the parent session's plane (ADR 36182); parent-own approvals omit it. */
  subagentOrigin?: ApprovalSubagentOrigin;
  subject: ApprovalSubject;
  taskId: string;
  toolCallId: string;
  toolName: string;
  turnId: string;
  viewCursor: string;
}

/** Approval-stage token carried in SS5 params and stale-requirement errors. */
export interface ApprovalRequirementRef {
  approvalId: string;
  sourceIndex: number;
}

/** Winning terminal returned to a losing `approval/decide` command. */
export interface ApprovalResolutionSummary {
  decision: string;
  resolvedBy: string;
  viewCursor: string;
}

export type ApprovalResolvedBy = "user" | "policy" | "llmJudge" | (string & {});

/** `approval/resolved` params: the first durable terminal decision. */
export interface ApprovalResolvedParams {
  amendment?: ApprovalAmendment;
  approvalId: string;
  /** The decision time as RFC3339, projected from the durable `DecisionApplied` record's own stamp (ADR 45450 D3): optional on the wire so decoders tolerate its absence, always populated by current hosts. */
  decidedAt?: string;
  decidedByCommandId?: string;
  decision: ApprovalDecision;
  itemId: string;
  policyResult: ApprovalPolicyResult;
  resolvedBy: ApprovalResolvedBy;
  sessionId: string;
  sourceRange: SourceRange;
  stageEvidence: ApprovalStageEvidence[];
  /** Present only for a child (native subagent) approval projected onto the parent session's plane (ADR 36182); parent-own approvals omit it. */
  subagentOrigin?: ApprovalSubagentOrigin;
  turnId: string;
  viewCursor: string;
}

export interface ApprovalStage {
  argv: string[];
  argvComplete: boolean;
  position: number;
  requirementId: ApprovalRequirementRef;
  resolution: ApprovalStageResolution;
  suggestedPrefix?: ApprovalSuggestedPrefix;
  totalStages: number;
}

export interface ApprovalStageEvidence {
  argv: string[];
  position: number;
  requirementId: ApprovalRequirementRef;
  resolution: ApprovalStageResolution;
  totalStages: number;
}

export interface ApprovalStageResolution {
  argvPrefix?: string[];
  diagnostic?: string;
  kind: string;
}

/** Child (native subagent) provenance for an approval projected onto the PARENT session's approval plane (#36182 / ADR 36182): identifies the originating child run/agent so a client can attribute the prompt. Omitted (`skip_serializing_if`) on the parent's own approvals, so pre-existing parent frames stay byte-identical. */
export interface ApprovalSubagentOrigin {
  /** The child run that parked on this approval. */
  childRunId: string;
  /** The child session stream id whose records carry this approval. */
  childSessionId: string;
  /** The originating child's subagent id, from the parent session's durable subagent control records. */
  subagentId: string;
}

/** Open approval subject union. Unknown kinds are rendered generically and never auto-approved by clients (tdd SS5.2). */
export interface ApprovalSubject {
  access?: string;
  command?: string;
  host?: string;
  /** Open discriminator: `shell | fileAccess | network | unixSocket | process | tool`. */
  kind: string;
  origin?: ApprovalOrigin;
  path?: string;
  port?: number;
  protocol?: string;
  stages?: ApprovalStage[];
  target?: string;
  toolName?: string;
  workspaceRoot?: string;
}

export interface ApprovalSuggestedPrefix {
  argvPrefix: string[];
  label: string;
}

/** `approval/updated` params: the refreshed pending view plus one change. */
export interface ApprovalUpdatedParams {
  approvalId: string;
  availableChoices: ApprovalChoice[];
  change: ApprovalChange;
  currentRequirementId: ApprovalRequirementRef;
  sessionId: string;
  sourceRange: SourceRange;
  /** Present only for a child (native subagent) approval projected onto the parent session's plane (ADR 36182); parent-own approvals omit it. */
  subagentOrigin?: ApprovalSubagentOrigin;
  subject: ApprovalSubject;
  viewCursor: string;
}

